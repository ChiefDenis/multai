BasedOnStyle: Google
Language: Cpp
Standard: c++20

IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 100

PointerAlignment: Left
DerivePointerAlignment: false

SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^"(llvm|llvm-c|clang|clang-c)/'
    Priority:        2
  - Regex:           '^<(.*)>'
    Priority:        3
  - Regex:           '^(<|")(gtest|gmock|isl|json)/'
    Priority:        4
  - Regex:           '^[<"]'
    Priority:        1
